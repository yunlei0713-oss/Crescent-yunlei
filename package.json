{
  "name": "moxun",
  "version": "1.0.12",
  "description": "墨巡 MoXun — 智能运维协作台 · Guided Ops",
  "main": "./out/main/index.js",
  "author": "MoXun",
  "homepage": "https://github.com/aide-family/Crescent",
  "repository": {
    "type": "git",
    "url": "https://github.com/aide-family/Crescent.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "ci": "npm run lint && npm run test && npm run build",
    "test": "node scripts/check-security-boundaries.cjs && node --test scripts/verify-managed-terminal.cjs",
    "test:local": "CRESCENT_LOCAL_TESTS=1 vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "prestart": "node scripts/prepare-development-icons.cjs",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "predev": "node scripts/prepare-development-icons.cjs",
    "build": "npm run typecheck && electron-vite build",
    "clean:build": "rm -rf dist node_modules/.cache",
    "postinstall": "electron-builder install-app-deps && node scripts/fix-node-pty-permissions.cjs && node scripts/prepare-development-icons.cjs && node scripts/install-git-hooks.cjs",
    "prebuild:unpack": "npm run icons",
    "build:unpack": "npm run verify:local && electron-builder --mac --x64 --dir --publish never",
    "prebuild:mac": "npm run icons",
    "build:mac": "npm run verify:local && electron-builder --mac --x64 --publish never",
    "build:mac:x64": "npm run build:mac",
    "build:mac:unsigned": "npm run build:mac:local",
    "icons": "node scripts/generate-icons.cjs",
    "smoke:packaging": "node scripts/smoke-packaging.cjs",
    "docs:dev": "npm --prefix website run dev",
    "docs:build": "npm --prefix website run build",
    "verify:local": "npm run ci && npm run test:local",
    "prebuild:mac:local": "npm run icons",
    "build:mac:local": "node scripts/build-macos-local.cjs",
    "build:mac:local:x64": "npm run build:mac:local"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@earendil-works/pi-agent-core": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^12.12.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.16",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.17.2",
    "node-pty": "^1.1.0",
    "openai": "^6.45.0",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "^1.6.0",
    "recharts": "^3.8.0",
    "sax": "1.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tree-sitter-wasms": "0.1.11",
    "tw-animate-css": "^1.4.0",
    "unzipper": "0.12.5",
    "web-tree-sitter": "0.20.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "3.4.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/headless": "6.0.0",
    "autoprefixer": "^10.5.2",
    "electron": "^41.10.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.15",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "undici@<7": "^6.29.0"
  }
}
